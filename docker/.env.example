# Purviewer Gradio Security Settings
# Copy to .env and customize for your environment

# Gradio Server Configuration
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# Security: Disable public share links
GRADIO_SHARE=False

# Security: Disable analytics/telemetry
GRADIO_ANALYTICS_ENABLED=False

# File Access Restrictions
# Only allow the /data directory for file operations
GRADIO_ALLOWED_PATHS=/data

# Block sensitive system paths
GRADIO_BLOCKED_PATHS=/home,/root,/etc,/var,/proc,/sys,/tmp

# Proxy Integration (set if behind reverse proxy with path prefix)
# GRADIO_ROOT_PATH=/purviewer

# Application Settings
PURVIEWER_DATA_DIR=/data
